<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lottery Miner"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="ഫോൺ മാത്രം ഉപയോഗിച്ചുള്ള Bitcoin Mainnet Direct P2P mining പരീക്ഷണം. Pool, Gateway, Proxy എന്നിവ ഉപയോഗിക്കുന്നില്ല. Block കണ്ടെത്താനുള്ള സാധ്യത വളരെ കുറവാണ്."
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="നിങ്ങളുടെ BTC വിലാസം (bc1…)"
            android:inputType="textNoSuggestions"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="പൂൾ ഹോസ്റ്റ്"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="പോർട്ട്"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etThreads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Worker lanes (1–8)"
                android:inputType="number"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="പരമാവധി °C"
                android:inputType="numberDecimal"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etBatt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ബാറ്ററി പരിധി %"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbCharging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="ചാർജിൽ ഇരിക്കുമ്പോൾ മാത്രം" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start direct P2P mining" />

        <Button
            android:id="@+id/btnPoolStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CKPool Live Statistics തുറക്കുക" />

        <Button
            android:id="@+id/btnBenchmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Run safe SHA-256d benchmark" />

        <TextView
            android:id="@+id/tvBenchmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#18242D"
            android:text="ADAPTIVE MINING LAB\nSHA-256d is the only installed algorithm. Benchmark runs locally while mining is stopped; no pool shares are submitted."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:id="@+id/tvProfitabilityHeader"
            android:text="BITCOIN PROFITABILITY ESTIMATOR"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvProfitabilityHelp"
            android:text="Legacy pool profitability tools are disabled in direct-P2P mode."
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etMiningPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mining power draw (W) — measured"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etElectricityTariff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Electricity tariff (₹ per kWh)"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etPoolFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pool fee (%) — CKPool default 2"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnRefreshProfitability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Refresh live BTC profitability estimate" />

        <TextView
            android:id="@+id/tvProfitability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#18242D"
            android:text="PROFITABILITY: Not calculated\nRun a benchmark and enter measured power + tariff."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnExportDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export direct-P2P verification report" />

        <TextView
            android:id="@+id/tvExternalStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#18242D"
            android:text="OCEAN EXTERNAL WORKER MONITOR\nWallet address നൽകുക.\nMonitoring സൗജന്യമാണ്; external mining power അല്ല."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
