<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHOENIX SOLO"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="DIRECT BITCOIN CORE MINING · Native phone SHA-256d · Full block submission. No pool-share mode."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bitcoin mainnet payout address"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="bc1…"
            android:inputType="textNoSuggestions"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Direct Node Gateway (HTTPS)"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://your-gateway.example"
            android:inputType="textUri"
            android:singleLine="true"
            android:autofillHints="" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Gateway API token (encrypted with Android Keystore)"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etApiToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="32-byte minimum secret"
            android:inputType="textPassword|textNoSuggestions"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etThreads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Workers"
                android:inputType="number"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Max °C"
                android:inputType="numberDecimal"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etBatt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Battery %"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbCharging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Mine only while charging" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START DIRECT SOLO" />

        <Button
            android:id="@+id/btnBenchmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Run safe local SHA-256d benchmark" />

        <TextView
            android:id="@+id/tvBenchmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#18242D"
            android:text="PHOENIX DIRECT SOLO\nNative SHA-256d · Bitcoin Core getblocktemplate · full block submitblock"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="BITCOIN SOLO EXPECTED VALUE"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live network difficulty, subsidy and BTC/INR are informational estimates only. Measure mining-only power with an external USB meter."
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etMiningPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Measured mining power (W)"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etElectricityTariff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Electricity tariff (₹/kWh)"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnRefreshProfitability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Refresh live Bitcoin estimate" />

        <TextView
            android:id="@+id/tvProfitability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#18242D"
            android:text="Expected value is not a payout forecast. A valid block must be accepted by Bitcoin Core and confirmed on the network."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnExportDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export Direct Solo verification report" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
