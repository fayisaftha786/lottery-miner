# Run this gateway on the same trusted host as Bitcoin Core.
# Keep Bitcoin Core RPC bound to loopback only; never expose port 8332 publicly.
BITCOIN_RPC_URL=http://127.0.0.1:8332/
BITCOIN_RPC_USER=phoenix_rpc
BITCOIN_RPC_PASSWORD=replace_with_a_long_random_password
PHOENIX_API_TOKEN=replace_with_at_least_32_random_bytes
# Bind only to loopback and publish through an HTTPS reverse proxy / VPN ingress.
PHOENIX_BIND_HOST=127.0.0.1
PHOENIX_PORT=8787
